{
  "name": "repo-interview",
  "version": "1.0.0",
  "description": "Repository",
  "main": "dist/main.js",
  "scripts": {
    "instalar": "npm ci && npm --prefix frontend ci",
    "predev": "node scripts/verificar-puertos.js 3002 4200",
    "dev": "concurrently --names \"api,web\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "predev:api": "node scripts/verificar-puertos.js 3002",
    "dev:api": "npm run start:dev",
    "predev:web": "node scripts/verificar-puertos.js 4200",
    "dev:web": "npm --prefix frontend start",
    "pruebas": "npm test && npm --prefix frontend test",
    "pruebas:cobertura": "npm run test:coverage && npm --prefix frontend run test:coverage",
    "build": "tsc",
    "start:dev": "tsnd  --respawn --clear --transpile-only ./src/main.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "^18.19.1 || ^20.11.1 || >=22.0.0"
  },
  "author": "...",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "multer": "1.4.5-lts.1",
    "reflect-metadata": "^0.2.1",
    "routing-controllers": "^0.10.4"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "concurrently": "9.2.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
